  "info": {
    "_postman_id": "ff43169b-a448-4297-ab5d-efb456786dcb",
    "name": "CricAPI Cricket Data Fantasy API",
    "description": "CricAPI (operating as CricketData.org) provides live cricket scores, ball-by-ball updates, match details, player statistics, team rankings, series schedules, and fantasy cricket scorecard data. Coverage spans international and domestic tournaments including ICC events, IPL, T20I, BBL, and PSL. Historical match data is available back to 2000.\n\nContact Support:\n Email: contact@cricketdata.org",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-21T21:05:13.000Z",
    "updatedAt": "2026-10-21T21:05:14.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-ff43169b-a448-4297-ab5d-efb456786dcb"
  },
